    "ws_icons.js",
    "ws_ui.js",
    "ws_store.js",
    "ws_api.js",
    "ws_thumbs.js",
    "ws_rail.js",
    "ws_overview.js",
    "ws_lens.js",
    "ws_bookmarks.js",
    "ws_questions.js",
    "ws_compare.js",
    "ws_upload.js",
    "ws_input.js",
    "ws_export.js",
    "ws_shell.js",
    "ws_main.js"
